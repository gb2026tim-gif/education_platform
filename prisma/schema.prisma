generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  JURY
  TEAM
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String?
  emailVerified Boolean  @default(false)
  role          Role     @default(TEAM)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Additional profile fields
  firstName String?
  lastName  String?
  city      String?
  school    String?
  phone     String?
  discord   String?
  image     String?

  sessions    Session[]
  accounts    Account[]
  captainOf   Team[]           @relation("TeamCaptain")
  tournaments Tournament[]     @relation("TournamentAdmin")
  juryScores  JuryAssignment[]

  @@map("users")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  RUNNING
  FINISHED
}

model Tournament {
  id          String           @id @default(cuid())
  title       String
  description String
  status      TournamentStatus @default(DRAFT)
  regStart    DateTime
  regEnd      DateTime
  maxTeams    Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  adminId String
  admin   User   @relation("TournamentAdmin", fields: [adminId], references: [id])

  teams Team[]
  tasks Task[]
  works Work[]

  @@map("tournaments")
}

enum TeamStatus {
  PENDING
  APPROVED
  REJECTED
}

model Team {
  id        String     @id @default(cuid())
  name      String
  city      String?
  contact   String?
  status    TeamStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  captainId    String
  captain      User       @relation("TeamCaptain", fields: [captainId], references: [id])
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  members     TeamMember[]
  submissions Submission[]

  @@unique([captainId, tournamentId])
  @@map("teams")
}

model TeamMember {
  id    String @id @default(cuid())
  name  String
  email String

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([email, teamId])
  @@map("team_members")
}

enum TaskStatus {
  DRAFT
  ACTIVE
  SUBMISSION_CLOSED
  EVALUATED
}

model Task {
  id           String     @id @default(cuid())
  title        String
  description  String
  requirements String[]
  techStack    String?
  startAt      DateTime
  deadline     DateTime
  status       TaskStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  submissions Submission[]

  @@map("tasks")
}

model Submission {
  id          String   @id @default(cuid())
  githubUrl   String
  videoUrl    String
  demoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  assignments JuryAssignment[]

  @@unique([taskId, teamId])
  @@map("submissions")
}

model JuryAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  juryId       String
  jury         User       @relation(fields: [juryId], references: [id])

  score Score?

  @@unique([submissionId, juryId])
  @@map("jury_assignments")
}

model Score {
  id              String   @id @default(cuid())
  backendQuality  Int
  databaseQuality Int
  frontendQuality Int
  functionality   Int
  stability       Int
  usability       Int
  total           Float
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignmentId String         @unique
  assignment   JuryAssignment @relation(fields: [assignmentId], references: [id])

  @@map("scores")
}

model Juror {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  avatarUrl       String?      @map("avatar_url")
  passwordHash    String?      @map("password_hash")
  passwordChanged Boolean      @default(false) @map("password_changed")
  createdAt       DateTime     @default(now()) @map("created_at")
  tokens          JuryToken[]
  assignments     Assignment[]

  @@map("jurors")
}

model Work {
  id           String       @id @default(cuid())
  teamName     String       @map("team_name")
  tournamentId String       @map("tournament_id")
  tournament   Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  githubUrl    String?      @map("github_url")
  videoUrl     String?      @map("video_url")
  liveDemoUrl  String?      @map("live_demo_url")
  description  String?
  createdAt    DateTime     @default(now()) @map("created_at")
  assignments  Assignment[]

  @@map("works")
}

model Assignment {
  id            String      @id @default(cuid())
  jurorId       String      @map("juror_id")
  juror         Juror       @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  workId        String      @map("work_id")
  work          Work        @relation(fields: [workId], references: [id], onDelete: Cascade)
  displayNumber Int         @map("display_number")
  evaluated     Boolean     @default(false)
  isDraft       Boolean     @default(false) @map("is_draft")
  evaluatedAt   DateTime?   @map("evaluated_at")
  evaluation    Evaluation?

  @@unique([jurorId, workId])
  @@map("assignments")
}

model Evaluation {
  id                    String     @id @default(cuid())
  assignmentId          String     @unique @map("assignment_id")
  assignment            Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  backendCode           Int        @default(50) @map("backend_code")
  databaseStructure     Int        @default(50) @map("database_structure")
  frontendCode          Int        @default(50) @map("frontend_code")
  backendFunctionality  Int        @default(50) @map("backend_functionality")
  databaseFunctionality Int        @default(50) @map("database_functionality")
  frontendFunctionality Int        @default(50) @map("frontend_functionality")
  comment               String?
  requirementsRest      Boolean    @default(false) @map("requirements_rest")
  requirementsDb        Boolean    @default(false) @map("requirements_db")
  requirementsAuth      Boolean    @default(false) @map("requirements_auth")
  requirementsFrontend  Boolean    @default(false) @map("requirements_frontend")
  requirementsDeploy    Boolean    @default(false) @map("requirements_deploy")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@map("evaluations")
}

model JuryToken {
  id        String   @id @default(cuid())
  jurorId   String   @map("juror_id")
  juror     Juror    @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("jury_tokens")
}
